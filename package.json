{
  "name": "vocabee",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:app && npm run build:dictionary",
    "build:app": "vite build --config vite.popup.config.js && vite build --config vite.content.config.js",
    "build:dictionary": "vite build --config vite.dictionary.config.js",
    "v": "npm run build:app",
    "d": "npm run build:dictionary",
    "dev": "node scripts/dev.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
