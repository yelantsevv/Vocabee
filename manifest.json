{
  "manifest_version": 3,
  "name": "Vocabee",
  "version": "1.0.1",
  "description": "Бесплатный переводчик слов и фраз в субтитрах YouTube. Создано с помощью ИИ.",
  "icons": {
    "16": "src/vocabee/icons/vocabee-16.png",
    "32": "src/vocabee/icons/vocabee-32.png",
    "48": "src/vocabee/icons/vocabee-48.png",
    "128": "src/vocabee/icons/vocabee-128.png"
  },
  "permissions": ["storage", "activeTab"],
  "host_permissions": [
    "<all_urls>",
    "https://translate.googleapis.com/*"
  ],
  "background": {
    "service_worker": "src/vocabee/background.js"
  },
  "action": {
    "default_title": "Vocabee",
    "default_icon": {
      "16": "src/vocabee/icons/vocabee-16.png",
      "32": "src/vocabee/icons/vocabee-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["src/vocabee/content/content.css", "dist/vocabee/content/content-app.css"],
      "js": [
        "src/vocabee/content/content-core.js",
        "src/vocabee/content/caption-language.js",
        "src/vocabee/content/video-pause.js",
        "src/vocabee/content/main.js",
        "dist/vocabee/content/content-app.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["src/vocabee/content/dev-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
