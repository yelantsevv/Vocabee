{
  "manifest_version": 3,
  "name": "Vocabee",
  "version": "1.1.1",
  "description": "Бесплатный переводчик слов и фраз в субтитрах YouTube.",
  "icons": {
    "16": "icons/vocabee-16.png",
    "32": "icons/vocabee-32.png",
    "48": "icons/vocabee-48.png",
    "128": "icons/vocabee-128.png"
  },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://translate.googleapis.com/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "background/index.js",
    "type": "module"
  },
  "action": {
    "default_title": "Vocabee",
    "default_icon": {
      "16": "icons/vocabee-inactive-16.png",
      "32": "icons/vocabee-inactive-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "css": ["content/content.css", "content/content-app.css"],
      "js": [
        "content/runtime/content-core.js",
        "content/runtime/caption-language.js",
        "content/runtime/video-pause.js",
        "content/runtime/main.js",
        "content/content-app.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://localhost/dictionary/dictionary.html*",
        "http://127.0.0.1/dictionary/dictionary.html*"
      ],
      "js": ["content/runtime/dev-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
